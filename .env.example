# Run node scripts/init-env.mjs to generate private local credentials.
DB_URL=jdbc:postgresql://127.0.0.1:55432/pharmacy
DB_USER=pharmacy
DB_PASSWORD=
OWNER_EMAIL=owner@pharmacy.local
OWNER_PASSWORD=
SEED_DEMO=true
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
MESSAGING_ENABLED=false
RABBITMQ_HOST=localhost
RABBITMQ_USER=pharmacy
RABBITMQ_PASSWORD=
METRICS_TOKEN=
GRAFANA_PASSWORD=
APP_VERSION=local

# Optional operational settings (defaults shown)
SESSION_TTL=8h
CACHE_TTL=5m
LOGIN_RATE_LIMIT=20
API_RATE_LIMIT=600
OUTBOX_PUBLISH_DELAY=10000
MAINTENANCE_DELAY=3600000
