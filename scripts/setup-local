#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
node scripts/init-env.mjs
set -a
source .env
set +a
PG_BIN="${PG_BIN:-/usr/local/opt/postgresql@16/bin}"
if [[ ! -x "$PG_BIN/pg_ctl" ]]; then echo 'Set PG_BIN to the bin directory of PostgreSQL 16+ or use Docker Compose.' >&2; exit 1; fi
mkdir -p .runtime/pgsocket
chmod 700 .runtime .runtime/pgsocket
if [[ ! -f .runtime/pgdata/PG_VERSION ]]; then
 "$PG_BIN/initdb" -D .runtime/pgdata -U "$DB_USER" --auth-local=trust --auth-host=scram-sha-256 --encoding=UTF8 --locale=C
fi
if ! "$PG_BIN/pg_ctl" -D .runtime/pgdata status >/dev/null 2>&1; then
 "$PG_BIN/pg_ctl" -D .runtime/pgdata -l .runtime/postgres.log -o "-p 55432 -h 127.0.0.1 -k $ROOT/.runtime/pgsocket" start
fi
# The cluster created in this session originally used /private/tmp; handle it without restarting.
PG_SOCKET="$ROOT/.runtime/pgsocket"
[[ -S "$PG_SOCKET/.s.PGSQL.55432" ]] || PG_SOCKET=/private/tmp
[[ "$DB_PASSWORD" =~ ^[a-zA-Z0-9_-]+$ ]] || { echo 'Native setup expects a generated alphanumeric DB_PASSWORD.' >&2; exit 1; }
PSQL=("$PG_BIN/psql" -h "$PG_SOCKET" -p 55432 -U "$DB_USER" -d postgres -v ON_ERROR_STOP=1 -At)
"${PSQL[@]}" <<SQL
ALTER USER pharmacy WITH PASSWORD '$DB_PASSWORD';
SQL
for database in pharmacy pharmacy_test; do
 if [[ -z "$("${PSQL[@]}" -c "SELECT 1 FROM pg_database WHERE datname='$database'")" ]]; then
  "${PSQL[@]}" -c "CREATE DATABASE $database"
 fi
 "${PSQL[@]}" -c "ALTER DATABASE $database SET timezone TO 'UTC'"
done
echo 'PostgreSQL is ready on 127.0.0.1:55432. Credentials are in .env.'
