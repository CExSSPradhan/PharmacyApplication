#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
if [[ -d "$ROOT/.tools/node-v22.22.0-darwin-x64/bin" ]]; then export PATH="$ROOT/.tools/node-v22.22.0-darwin-x64/bin:$PATH"; fi
exec frontend/node_modules/.bin/prettier --write 'backend/src/**/*.java' 'frontend/src/**/*.{ts,tsx,css}' 'frontend/*.ts' 'frontend/e2e/*.ts' 'docs/*.md' README.md CONTRIBUTING.md
