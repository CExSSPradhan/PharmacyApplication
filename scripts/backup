#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
set -a
source "$ROOT/.env"
set +a
export PGPASSWORD="$DB_PASSWORD"
PG_BIN="${PG_BIN:-/usr/local/opt/postgresql@16/bin}"
mkdir -p "$ROOT/.runtime/backups"
BACKUP_FILE="$ROOT/.runtime/backups/pharmacy-$(date -u +%Y%m%dT%H%M%SZ).dump"
"$PG_BIN/pg_dump" -h 127.0.0.1 -p 55432 -U "$DB_USER" -d pharmacy --format=custom --no-owner --file="$BACKUP_FILE"
chmod 600 "$BACKUP_FILE"
echo "$BACKUP_FILE"
