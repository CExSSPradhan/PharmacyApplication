#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
for candidate in "$ROOT"/.tools/jdk-*/Contents/Home; do
  if [[ -x "$candidate/bin/java" ]]; then export JAVA_HOME="$candidate"; break; fi
done
export PATH="${JAVA_HOME:+$JAVA_HOME/bin:}$PATH"
if [[ -x "$ROOT/.tools/apache-maven-3.9.11/bin/mvn" ]]; then
 exec "$ROOT/.tools/apache-maven-3.9.11/bin/mvn" -Dmaven.repo.local="$ROOT/.tools/m2" -f "$ROOT/backend/pom.xml" "$@"
fi
exec mvn -f "$ROOT/backend/pom.xml" "$@"
